# DeepShield-RAG server configuration. Copy this file to .env for local use.
# Never commit the real .env file or an API key.

DEEPSHIELD_REPOSITORY_ROOT=.
DEEPSHIELD_INDEX_REPORT=data/manifests/f1-policy-vector-index-report.v1.json
DEEPSHIELD_MODEL_CACHE=data/indexes/models
DEEPSHIELD_EMBEDDING_THREADS=1

# Frozen research model. API access and billing are separate from a ChatGPT subscription.
DEEPSHIELD_LLM_BASE_URL=https://api.openai.com/v1
DEEPSHIELD_LLM_MODEL=gpt-5.4-mini-2026-03-17
DEEPSHIELD_LLM_REASONING_EFFORT=none
DEEPSHIELD_LLM_MAX_TOKEN_PARAMETER=max_completion_tokens
DEEPSHIELD_LLM_TIMEOUT_SECONDS=60
DEEPSHIELD_LLM_MAX_OUTPUT_TOKENS=700

# Copy your server-side API key here only in the ignored .env file.
# DEEPSHIELD_LLM_API_KEY=
